{
  "name": "polarops",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"vite\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "node scripts/dev-api.mjs",
    "build": "vite build",
